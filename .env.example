# Local Postgres, started with `docker compose up -d` (see docker-compose.yml).
# Ship 1.10 points this at Neon in production instead.
DATABASE_URL=postgres://lai_matemaatika:lai_matemaatika@localhost:5432/lai_matemaatika

# Signs the anonymous guest-session cookie (Ship 1.7). Any long random
# string; generate one with `openssl rand -base64 32`. Required in
# production; a fixed dev-only fallback is used when unset outside it.
GUEST_COOKIE_SECRET=

# Authentication (Ship 3.3, see docs/auth.md). Each provider below only
# registers itself once its own variables are all set — leave any of these
# blank to run with that provider disabled.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
EMAIL_SERVER=
EMAIL_FROM=
