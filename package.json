{
  "name": "lai-matemaatika",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run generate:registry",
    "dev": "next dev",
    "prebuild": "npm run generate:registry",
    "build": "next build",
    "vercel-build": "drizzle-kit migrate && npm run generate:registry && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "pretest": "npm run generate:registry",
    "test": "vitest run",
    "check": "npm run generate:registry && tsc --noEmit && eslint . && vitest run",
    "generate:registry": "tsx scripts/generate-registry-index.ts",
    "coverage:content": "npm run generate:registry && tsx scripts/coverage-content.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@mdx-js/mdx": "^3.1.1",
    "drizzle-orm": "^0.45.2",
    "katex": "^0.18.5",
    "next": "15.5.25",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "postgres": "^3.4.9",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4",
    "@types/katex": "^0.16.8",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.12",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.5",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
